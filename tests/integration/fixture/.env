# Integration fixture env (not secrets): proves the Rust server loads .env
# files from the project root at startup and the Node worker inherits them.
GIO_FIXTURE_DOTENV=from-dotenv
GIO_FIXTURE_PRECEDENCE=from-env
GIO_FIXTURE_PROCESS_WINS=from-dotenv
GIO_PUBLIC_FIXTURE_GREETING=FIXTURE_PUBLIC_VALUE
GIO_FIXTURE_PRIVATE=FIXTURE_PRIVATE_VALUE
# The /api/login demo password.
GIO_FIXTURE_LOGIN_PASSWORD=fixture-password
