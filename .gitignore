# Rust
/target/
crates/*/target/
**/*.rs.bk
# Cargo.lock is committed on purpose: release binaries must build from the
# exact crate versions CI tested (`--locked`), not whatever resolves that day.

# Node
node_modules/
packages/*/node_modules/
examples/*/node_modules/
packages/*/dist/
*.tsbuildinfo

# GioJS build output
.gio/
!.gio/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.suo
*.user

# Temp / debug output
*.log
server-*.txt
node-test*.txt

# docs-site static build output + local preview scratch
docs-site/out/
docs-site/_*.mjs

# Local editor / tool settings (machine-specific)
.claude/

# Local scratch / test scaffolds
/dist-test/
/test-app/

# Platform binaries - provided by CI at release, never committed
platform/*/bin/*
!platform/*/bin/.gitkeep

# Internal docs / specs - NOT for public release
/CLAUDE.md
/SPEC.MD
/SPEC2.MD
/SPEC.md
/SPEC2.md
/OPEN_QUESTIONS.md
tests/integration/.dev-fixture/
tests/integration/.image-cache-fixture/
tests/integration/.build-cache-fixture/
tests/integration/.config-fixture/
tests/integration/.dev-cache-fixture/
tests/integration/.switches-fixture/

# stray local probe file
probe.tmp
